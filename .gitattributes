# Fins de ligne normalisées (Windows / Mac)
* text=auto

# Fichiers texte Unity (Force Text) : fusion intelligente
*.cs        text diff=csharp
*.unity     text merge=unityyamlmerge eol=lf
*.prefab    text merge=unityyamlmerge eol=lf
*.asset     text merge=unityyamlmerge eol=lf
*.mat       text merge=unityyamlmerge eol=lf
*.anim      text merge=unityyamlmerge eol=lf
*.controller text merge=unityyamlmerge eol=lf
*.meta      text eol=lf
*.inputactions text

# Fichiers binaires : jamais fusionnés ni modifiés
*.png  binary
*.jpg  binary
*.jpeg binary
*.psd  binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.ttf  binary
*.otf  binary
*.fbx  binary
*.pdf  binary
